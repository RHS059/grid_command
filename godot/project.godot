; Grid Command — native desktop vertical slice.
config_version=5

[application]
config/name="Grid Command"
config/description="A native tactical command game. Secure the harbor."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/version="0.1.1"

[autoload]
UpdateService="*res://scripts/update_service.gd"

[updates]
channel_url="https://github.com/RHS059/grid_command/releases/latest/download/godot-update.json"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=1100
window/size/min_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.73, 1)
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=30

[audio]
driver/enable_input=false
